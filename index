        <!-- DASHBOARD CONTENT -->
        <main class="flex-1 overflow-y-auto p-6 lg:p-8 space-y-8 bg-slate-100/50">

            <!-- 1. นักเรียน & ผลสัมฤทธิ์ (เพิ่มมิติความเหลื่อมล้ำ) -->
            <section id="student" class="space-y-4">
                <div class="flex items-center space-x-3 border-b pb-2 border-slate-200">
                    <div class="p-2 bg-amber-500 text-white rounded-lg shadow-sm"><i class="fa-solid fa-users"></i></div>
